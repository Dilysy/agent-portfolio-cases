# 智能竞品分析 Agent 环境变量示例
# 只填写占位符，不要提交真实 API Key。

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# 如使用 Anthropic，可按需启用。
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Tavily Search API，用于公开信息搜索。
TAVILY_API_KEY=

OUTPUT_DIR=./outputs
LOG_LEVEL=INFO
MAX_SEARCH_QUERIES=20
REQUEST_TIMEOUT=30

# 如当前网络环境需要代理，再按本机实际情况配置。
HTTP_PROXY=
HTTPS_PROXY=
